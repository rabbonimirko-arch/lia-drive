{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "api/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "tailwind.config.ts"
  ]
}
